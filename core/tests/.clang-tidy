---
# Qt Test needs non-static private slots in classes that live in the test
# translation unit, `_data` functions that follow QTest naming, and QFETCH
# locals that cannot be const.
InheritParentConfig: true
Checks: >
  -misc-const-correctness,
  -misc-use-internal-linkage,
  -readability-convert-member-functions-to-static,
  -readability-function-cognitive-complexity
CheckOptions:
  - { key: readability-identifier-naming.MethodIgnoredRegexp, value: '.*_data' }
